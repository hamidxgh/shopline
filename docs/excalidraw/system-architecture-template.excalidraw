      "link": null,
      "locked": false,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0
    },
    {
      "type": "text",
      "x": 900,
      "y": 848,
      "width": 400,
      "height": 24,
      "text": "SHOPLINE FILL-IN\nGo \u00b7 Postgres \u00b7 Redis\nRabbitMQ \u00b7 Redpanda\nMeilisearch \u00b7 ClickHouse\nKeycloak \u00b7 Vault \u00b7 etcd\nnginx \u00b7 Traefik \u00b7 Varnish\nCoreDNS \u00b7 Toxiproxy \u00b7 OTel",
      "originalText": "SHOPLINE FILL-IN\nGo \u00b7 Postgres \u00b7 Redis\nRabbitMQ \u00b7 Redpanda\nMeilisearch \u00b7 ClickHouse\nKeycloak \u00b7 Vault \u00b7 etcd\nnginx \u00b7 Traefik \u00b7 Varnish\nCoreDNS \u00b7 Toxiproxy \u00b7 OTel",
