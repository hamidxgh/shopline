# Copy to .env for local overrides. Compose already sets lab defaults.
# Never commit a real .env.

# App
DATABASE_URL=postgres://shopline:shopline@db.shopline.local:5432/shopline
DATABASE_REPLICA_URL=postgres://shopline:shopline@postgres-replica:5432/shopline
REDIS_ADDR=toxiproxy:16379
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
KAFKA_BROKERS=redpanda:9092
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=shopline
S3_SECRET_KEY=shopline-secret
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=shopline-masterkey
ETCD_ENDPOINTS=etcd:2379
OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4318
KEYCLOAK_ISSUER=http://localhost:8084/realms/shopline
KEYCLOAK_DISCOVERY=http://keycloak:8080/realms/shopline
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=shopline
CLICKHOUSE_PASSWORD=shopline
CLICKHOUSE_DB=shopline
